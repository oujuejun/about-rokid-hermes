# Rokid -> Hermes Bridge configuration
# Copy this file to .env, then replace every value marked REQUIRED.

# Hermes Gateway API address.
# Same host: http://127.0.0.1:8642
# Remote host: use a private-network URL whenever possible.
HERMES_GATEWAY_URL=http://localhost:8642

# Model name accepted by your Hermes Gateway.
HERMES_MODEL=mimo-v2.5

# REQUIRED: shared secret used by the Rokid Lingzhu platform.
# Generate one on Linux with: openssl rand -hex 32
ROKID_AK=your-ak-here

# Local bridge port.
BRIDGE_PORT=8900

# REQUIRED: must match API_SERVER_KEY in the Hermes Gateway environment.
HERMES_API_KEY=your-gateway-api-key-here

# Optional: requires the Mnemosyne Python package and backend.
# ENABLE_MEMORY_EXTRACTOR=false
# MEMORY_BACKEND=mnemosyne
